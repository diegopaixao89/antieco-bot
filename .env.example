# Token do bot — obtido no @BotFather
TELEGRAM_BOT_TOKEN=seu_token_aqui

# PostgreSQL para deploy na nuvem (deixar em branco usa SQLite local)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Quantos dias o histórico dura (0 = sem limite)
DUPLICATE_WINDOW_DAYS=30

# Tamanho mínimo de texto para checar duplicatas
TEXT_MIN_LENGTH=20

# Quantas vezes um texto pode ser repetido antes de ser bloqueado
TEXT_MAX_REPEATS=3
